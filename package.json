{
	"name": "@motaouakel/n8n-nodes-litellm",
	"version": "0.2.2",
	"description": "n8n community node for the LiteLLM proxy management API: virtual keys, teams, users, models and spend",
	"license": "MIT",
	"homepage": "https://github.com/motawakil/n8n-nodes-litellm#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"litellm",
		"llm",
		"llmops",
		"ai-gateway"
	],
	"author": {
		"name": "Motaouakel",
		"email": "motaouakelmaimo19@gmail.com"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test test/*.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/**/*.map",
		"!dist/docs/**"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/LiteLlmApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/LiteLlm/LiteLlm.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.29.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/motawakil/n8n-nodes-litellm.git"
	},
	"bugs": {
		"url": "https://github.com/motawakil/n8n-nodes-litellm/issues"
	}
}
